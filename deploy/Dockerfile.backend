FROM maven:3.9-eclipse-temurin-11 AS build

WORKDIR /workspace
COPY blog-springboot/pom.xml ./pom.xml
RUN mvn -B -DskipTests dependency:go-offline

COPY blog-springboot/src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:11-jre-jammy

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /workspace/target/*.jar /app/blog.jar

EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=6 \
  CMD curl --fail --silent http://127.0.0.1:8080/ >/dev/null || exit 1

ENTRYPOINT ["/bin/sh", "-c", "exec java ${JAVA_OPTS} -jar /app/blog.jar"]

