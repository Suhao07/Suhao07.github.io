# DNS A/AAAA 记录必须先指向目标服务器。
SITE_DOMAIN=blog.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=owner@example.com

MYSQL_DATABASE=blog_temp
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_USERNAME=blog
DB_PASSWORD=replace-with-a-long-random-database-password
# 必须替换为 bcrypt 哈希；部署脚本会拒绝默认弱密码。
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

REDIS_PASSWORD=replace-with-a-long-random-redis-password
RABBITMQ_USERNAME=blog
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
RABBITMQ_VIRTUAL_HOST=/

SWAGGER_USERNAME=disabled
SWAGGER_PASSWORD=replace-with-a-long-random-password

# 可选：配置后才启用腾讯云验证码。
VUE_APP_TENCENT_CAPTCHA=
